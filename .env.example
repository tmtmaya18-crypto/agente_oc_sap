# Copia este archivo a .env y completa los valores. Nunca subas .env al repositorio.

# Proveedor y modelo de lenguaje
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-4-5
ANTHROPIC_API_KEY=
# Timeout por llamada al proveedor (milisegundos)
LLM_TIMEOUT_MS=30000

# Topes de costo
MAX_ITERACIONES=25
MAX_TOKENS_SESION=150000
MAX_TOKENS_GLOBAL=2000000

# Servidor
PORT=3000
